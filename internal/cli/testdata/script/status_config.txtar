# Settings come from ~/.config/dots/config.toml.
dotfiles
mkdir $HOME/Pictures/wallpapers/new
cp photo $HOME/Pictures/wallpapers/new/photo.jpg
cp photo $HOME/Pictures/holiday.jpg

# By default ~/Pictures is checked, since it holds a tracked folder.
exitcode 1 dots status
stdout '~/Pictures/holiday.jpg'
stdout '~/Pictures/wallpapers/new'

# Skipping it leaves only the folder inside the tracked wallpapers folder.
mkdir $HOME/.config/dots
cp skip-pictures.toml $HOME/.config/dots/config.toml
exitcode 1 dots status
! stdout holiday
stdout '~/Pictures/wallpapers/new'

# A modify template replaced by a plain copy is reported.
rm $HOME/Pictures/wallpapers/new
cp templates.toml $HOME/.config/dots/config.toml
exitcode 1 dots status
cmp stdout want-templates.txt

# The environment overrides the file. An empty variable counts as unset.
env DOTS_LEFTOVERS_SKIP=~
exitcode 1 dots status
stdout '~/Pictures/holiday.jpg'
env DOTS_LEFTOVERS_SKIP=
exitcode 1 dots status
! stdout holiday

# DOTS_CONFIG and --config choose another file; --config wins. The default
# file reports nothing, so each result shows which file was read.
cp skip-pictures.toml $HOME/.config/dots/config.toml
exitcode 0 dots status
cp templates.toml other.toml
env DOTS_CONFIG=$WORK/other.toml
exitcode 1 dots status
stdout 'modify templates'
exitcode 0 dots status --config $WORK/skip-pictures.toml
env DOTS_CONFIG=

# Mistakes in the file stop dots with exit 2.
cp typo.toml $HOME/.config/dots/config.toml
exitcode 2 dots status
! stdout .
stderr '^dots: config file .*config.toml: unknown setting "leftovers.skp"$'

cp bad-type.toml $HOME/.config/dots/config.toml
exitcode 2 dots status
stderr '^dots: config: ''fetch_timeout'' 10 is not a duration; write it as a string such as "10s"$'

exitcode 2 dots status --config $WORK/missing.toml
stderr 'missing.toml'

-- photo --
jpeg
-- skip-pictures.toml --
[leftovers]
skip = ["~", "~/.config", "~/.ssh", "~/Pictures"]
-- templates.toml --
[leftovers]
skip = ["~", "~/.config", "~/.ssh", "~/Pictures"]
[[modify_templates]]
file = "~/.config/zed/settings.json"
keep = '"theme"\s*:\s*\{[^{}]*\}'
[[modify_templates]]
file = "~/.config/btop/btop.conf"
keep = '^color_theme = .*$'
-- typo.toml --
[leftovers]
skp = ["~/Pictures"]
-- bad-type.toml --
fetch_timeout = 10
-- want-templates.txt --
Should be modify templates, but the repo has plain copies
  ~/.config/btop/btop.conf
-- home/dotfiles/home/dot_bashrc --
bashrc
-- home/dotfiles/home/Pictures/wallpapers/japan.jpg --
jpeg
-- home/dotfiles/home/dot_config/zed/modify_settings.json --
{{/* chezmoi:modify-template */}}{{ .chezmoi.stdin }}
-- home/dotfiles/home/dot_config/btop/btop.conf --
btop

# Without chezmoi set up, dot status says so and exits 2.
exitcode 2 dot status
! stdout .
stderr '^dot: chezmoi is not set up on this machine; run chezmoi init first$'

# Bad usage also exits 2.
exitcode 2 dot status extra
stderr 'unknown command "extra" for "dot status"'
exitcode 2 dot status --bogus
stderr '^dot: unknown flag: --bogus$'

exitcode 0 dot status --help
stdout 'Exits 0 when everything is in sync'

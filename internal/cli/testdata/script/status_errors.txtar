# Without chezmoi set up, dots status says so and exits 2.
exitcode 2 dots status
! stdout .
stderr '^dots: chezmoi is not set up on this machine; run chezmoi init first$'

# Bad usage also exits 2.
exitcode 2 dots status extra
stderr 'unknown command "extra" for "dots status"'
exitcode 2 dots status --bogus
stderr '^dots: unknown flag: --bogus$'

exitcode 0 dots status --help
stdout 'Exits 0 when everything is in sync'

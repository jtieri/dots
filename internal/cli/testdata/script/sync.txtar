# Another machine pushes a change, and dot sync pulls and applies it.
dotfiles
exec git clone --quiet $WORK/remote.git $WORK/other
cp newer $WORK/other/home/dot_profile
exec git -C $WORK/other commit --quiet --all --message=elsewhere
exec git -C $WORK/other push --quiet
exitcode 0 dot sync --yes
cmp stdout pulled.txt
cmp $HOME/.profile newer

# Nothing new since.
exitcode 0 dot sync
cmp stdout nothing.txt

# When both machines have committed, dot sync stops and changes nothing.
cp newer $WORK/other/home/dot_bashrc
exec git -C $WORK/other commit --quiet --all --message=elsewhere
exec git -C $WORK/other push --quiet
cp here $HOME/dotfiles/home/dot_profile
exec git -C $HOME/dotfiles commit --quiet --all --message=here
exitcode 2 dot sync --yes
! stdout .
stderr '^dot: nothing was pulled, because this machine and the remote both have new commits \(1 commit not pushed, 1 commit not pulled\)'
cmp $HOME/.bashrc shell
cmp $HOME/.profile newer

-- newer --
newer
-- here --
changed here
-- shell --
shell
-- pulled.txt --
Pulled 1 commit.

Will update
  ~/.profile

Done. The home directory matches the repo.
-- nothing.txt --
Nothing to pull.

Nothing to apply; the home directory matches the repo.
-- home/dotfiles/home/dot_bashrc --
shell
-- home/dotfiles/home/dot_profile --
shell
